# ---------------------------------------------------------------
# Copy this file to .env and replace every placeholder.
# .env is ignored by Git. Never put real values in this file.
# ---------------------------------------------------------------

# Backend (embedded Tomcat) port
SERVER_PORT=8080

# PostgreSQL connection (used from Sprint 1)
# Local development:  jdbc:postgresql://localhost:5432/homestay
# Docker Compose:     jdbc:postgresql://postgres:5432/homestay
DB_URL=jdbc:postgresql://localhost:5432/homestay
DB_USERNAME=<database-username>
DB_PASSWORD=<database-password>

# JWT signing secret (at least 32 random characters) and token lifetime
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRY_MINUTES=480

# First administrator account, created on first start (MVP-02)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<first-admin-password>
